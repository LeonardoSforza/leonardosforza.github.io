---
interface Props {
	title: string;
	href: string;
	icon?: string;
	date?: Date | string | null;
	cover?: string | null;
	index: number;
	total: number;
}

const { title, href, icon = '📍', date, cover, index, total } = Astro.props;

const dateLabel = date
	? new Date(date).toLocaleDateString('en-GB', {
			day: 'numeric',
			month: 'short',
			year: 'numeric',
		})
	: null;
---

<a class="entry-card" href={href}>
	{
		cover ? (
			<img class="thumb" src={cover} alt="" loading="lazy" />
		) : (
			<span class="thumb-fallback" aria-hidden="true">
				{icon}
			</span>
		)
	}
	<span class="copy">
		<span class="index">Stop {index} of {total}</span>
		<span class="title">{icon} {title}</span>
		{dateLabel && <time datetime={new Date(date!).toISOString()}>{dateLabel}</time>}
	</span>
</a>

<style>
	.entry-card {
		display: grid;
		grid-template-columns: 5rem 1fr;
		gap: var(--space-3);
		align-items: center;
		padding: var(--space-2);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		text-decoration: none;
		color: inherit;
		background: var(--bg);
		transition: background 120ms var(--ease-out);
	}

	.entry-card:hover {
		background: var(--bg-hover);
		color: inherit;
	}

	.thumb,
	.thumb-fallback {
		width: 5rem;
		height: 3.75rem;
		border-radius: var(--radius);
		object-fit: cover;
		background: var(--bg-elevated);
	}

	.thumb-fallback {
		display: grid;
		place-items: center;
		font-size: 1.25rem;
	}

	.copy {
		display: grid;
		gap: 0.15rem;
		min-width: 0;
	}

	.index {
		font-family: var(--font-ui);
		font-size: 0.7rem;
		color: var(--ink-faint);
	}

	.title {
		font-family: var(--font-ui);
		font-size: 0.95rem;
		font-weight: 560;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	time {
		font-family: var(--font-ui);
		font-size: 0.78rem;
		color: var(--ink-muted);
	}
</style>
