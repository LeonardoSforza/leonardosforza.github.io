---
interface Props {
	prev?: { href: string; title: string } | null;
	next?: { href: string; title: string } | null;
	homeHref: string;
	index: number;
	total: number;
}

const { prev, next, homeHref, index, total } = Astro.props;
const progress = total > 0 ? index / total : 0;
---

<nav class="entry-nav" aria-label="Journey navigation">
	<div class="progress" aria-hidden="true">
		<span style={`transform: scaleX(${progress})`}></span>
	</div>
	<div class="shell bar">
		<a class="home" href={homeHref}>All stops</a>
		<span class="count">Stop {index} of {total}</span>
		<div class="links">
			{
				prev ? (
					<a href={prev.href} rel="prev">
						← {prev.title}
					</a>
				) : (
					<span class="muted">← Start</span>
				)
			}
			{
				next ? (
					<a href={next.href} rel="next">
						{next.title} →
					</a>
				) : (
					<span class="muted">End →</span>
				)
			}
		</div>
	</div>
</nav>

<style>
	.entry-nav {
		position: sticky;
		top: 2.85rem;
		z-index: 30;
		background: var(--header-bg);
		border-bottom: 1px solid var(--border);
		margin-bottom: var(--space-6);
	}

	.progress {
		height: 2px;
		background: var(--border);
	}

	.progress span {
		display: block;
		height: 100%;
		transform-origin: left center;
		background: var(--accent);
		animation: progress-grow 500ms var(--ease-out) both;
	}

	.bar {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: var(--space-3);
		align-items: center;
		min-height: 2.5rem;
		font-family: var(--font-ui);
		font-size: 0.8rem;
	}

	.home,
	.links a {
		color: var(--ink-muted);
		text-decoration: none;
		padding: 0.2rem 0.35rem;
		border-radius: var(--radius);
	}

	.home:hover,
	.links a:hover {
		background: var(--bg-hover);
		color: var(--ink);
	}

	.count {
		text-align: center;
		color: var(--ink-faint);
		font-size: 0.75rem;
	}

	.links {
		display: flex;
		gap: var(--space-2);
		justify-content: flex-end;
		min-width: 0;
	}

	.links a,
	.muted {
		max-width: 10rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.muted {
		color: var(--ink-faint);
		padding: 0.2rem 0.35rem;
	}

	@media (max-width: 720px) {
		.bar {
			grid-template-columns: 1fr;
			padding-block: var(--space-2);
			gap: var(--space-2);
		}

		.count,
		.links {
			justify-content: space-between;
			text-align: left;
		}
	}
</style>
