---
/**
 * Sahaj Work status — visual placeholder only.
 * Future shape (not live yet):
 * { date: string, kind: 'talk' | 'self-realization' | 'program' | 'other', note?: string }[]
 */
const cells = Array.from({ length: 52 }, (_, i) =>
	(i * 7) % 5 === 0 ? 2 : (i * 3) % 4 === 0 ? 1 : 0,
);
---

<aside class="sahaj" aria-label="Sahaj Work status placeholder">
	<div class="sahaj-head">
		<span class="sahaj-label">Sahaj Work</span>
		<span class="sahaj-badge">Coming soon</span>
	</div>
	<div class="sahaj-graph" role="img" aria-label="Placeholder activity graph">
		{cells.map((level) => <span class:list={['cell', `l${level}`]} />)}
	</div>
	<p class="sahaj-copy">Talks, self-realization, and programs — tracked here later.</p>
</aside>

<style>
	.sahaj {
		width: min(100%, 22rem);
		padding: var(--space-4);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--bg-elevated);
	}

	.sahaj-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		margin-bottom: var(--space-3);
	}

	.sahaj-label {
		font-family: var(--font-ui);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--ink-muted);
	}

	.sahaj-badge {
		font-family: var(--font-ui);
		font-size: 0.7rem;
		padding: 0.15rem 0.4rem;
		border-radius: var(--radius);
		background: var(--bg-hover);
		color: var(--ink-faint);
	}

	.sahaj-graph {
		display: grid;
		grid-template-columns: repeat(26, 1fr);
		gap: 3px;
		margin-bottom: var(--space-3);
	}

	.cell {
		aspect-ratio: 1;
		border-radius: 2px;
		background: var(--sahaj-0);
	}

	.cell.l1 {
		background: var(--sahaj-1);
	}
	.cell.l2 {
		background: var(--sahaj-2);
	}

	.sahaj-copy {
		margin: 0;
		font-family: var(--font-ui);
		font-size: 0.8rem;
		color: var(--ink-faint);
		line-height: 1.4;
	}
</style>
