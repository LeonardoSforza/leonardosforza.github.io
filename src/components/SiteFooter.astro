---
import SahajStatus from './SahajStatus.astro';
---

<footer class="site-footer">
	<div class="shell footer-inner">
		<div class="footer-brand">
			<img src="/brand/logo.svg" alt="" width="22" height="22" />
			<span>Leonardo Sforza</span>
		</div>
		<SahajStatus />
		<p class="footer-note">Letters written locally, shipped through git.</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		padding: var(--space-7) 0 var(--space-8);
		background: var(--bg);
	}

	.footer-inner {
		display: grid;
		gap: var(--space-5);
		justify-items: start;
	}

	.footer-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-ui);
		font-size: 0.9rem;
		font-weight: 600;
	}

	.footer-note {
		margin: 0;
		font-family: var(--font-ui);
		font-size: 0.8rem;
		color: var(--ink-faint);
	}
</style>
