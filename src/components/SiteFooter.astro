---
import SahajStatus from './SahajStatus.astro';
import BrandWordmark from './BrandWordmark.astro';
---

<footer class="site-footer">
	<div class="shell footer-inner">
		<div class="footer-brand">
			<BrandWordmark />
		</div>
		<SahajStatus />
		<p class="footer-note">Letters written locally, shipped through git.</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		padding: var(--space-7) 0 var(--space-8);
		background: var(--bg);
	}

	.footer-inner {
		display: grid;
		gap: var(--space-5);
		justify-items: start;
	}

	.footer-brand {
		color: var(--ink);
	}

	.footer-note {
		margin: 0;
		font-family: var(--font-ui);
		font-size: 0.8rem;
		color: var(--ink-faint);
	}
</style>
