---
interface Props {
	title: string;
	href: string;
	summary?: string;
	icon?: string;
	date?: Date | string | null;
	cover?: string | null;
}

const { title, href, summary = '', icon = '✉️', date, cover } = Astro.props;

const dateLabel = date
	? new Date(date).toLocaleDateString('en-GB', {
			day: 'numeric',
			month: 'short',
			year: 'numeric',
		})
	: null;
---

<a class="letter-card" href={href}>
	{
		cover ? (
			<div class="cover-wrap">
				<img src={cover} alt="" loading="lazy" />
			</div>
		) : (
			<div class="cover-fallback" aria-hidden="true">
				{icon}
			</div>
		)
	}
	<div class="body">
		<div class="meta">
			<span class="icon" aria-hidden="true">{icon}</span>
			{dateLabel && <time datetime={new Date(date!).toISOString()}>{dateLabel}</time>}
		</div>
		<h3>{title}</h3>
		{summary && <p>{summary}</p>}
	</div>
</a>

<style>
	.letter-card {
		display: grid;
		grid-template-rows: 10rem auto;
		text-decoration: none;
		color: inherit;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--bg);
		transition: background 120ms var(--ease-out);
	}

	.letter-card:hover {
		background: var(--bg-hover);
		color: inherit;
	}

	.cover-wrap,
	.cover-fallback {
		height: 10rem;
		overflow: hidden;
		background: var(--bg-elevated);
		border-bottom: 1px solid var(--border);
	}

	.cover-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cover-fallback {
		display: grid;
		place-items: center;
		font-size: 2.25rem;
	}

	.body {
		padding: var(--space-4);
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: var(--space-2);
		font-family: var(--font-ui);
		font-size: 0.75rem;
		color: var(--ink-faint);
	}

	h3 {
		margin: 0 0 var(--space-2);
		font-size: 1.05rem;
		font-weight: 600;
	}

	p {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.9rem;
		line-height: 1.45;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
