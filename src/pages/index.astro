---
import SiteLayout from '../layouts/SiteLayout.astro';
import LetterCard from '../components/LetterCard.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { getCollection } from 'astro:content';

const letters = (await getCollection('letters'))
	.filter((letter) => letter.data.status === 'published')
	.sort((a, b) => {
		const da = a.data.publishedAt?.getTime() ?? 0;
		const db = b.data.publishedAt?.getTime() ?? 0;
		return db - da;
	});

const featured = letters[0];
---

<SiteLayout
	title="Leonardo Sforza"
	description="Personal letters from Leonardo Sforza — travel, Sahaja, and the road in between."
>
	<section class="hero shell">
		<div class="hero-brand">
			<h1 class="sr-only">Leonardo Sforza</h1>
			<BrandLogo />
		</div>
		<p class="lede">Personal letters — written on the road, shared like a quiet newsletter.</p>
		<div class="cta">
			<a class="btn btn-primary" href="/letters/">Read the letters</a>
			{
				featured && (
					<a class="btn btn-ghost" href={`/letters/${featured.id}/`}>
						Latest: {featured.data.title}
					</a>
				)
			}
		</div>
	</section>

	{
		letters.length > 0 && (
			<section class="latest shell">
				<div class="section-head">
					<h2>Latest letter</h2>
					<a href="/letters/">All letters</a>
				</div>
				<div class="grid">
					{letters.slice(0, 3).map((letter) => (
						<LetterCard
							title={letter.data.title}
							href={`/letters/${letter.id}/`}
							summary={letter.data.summary}
							icon={letter.data.icon}
							date={letter.data.publishedAt}
							cover={letter.data.cover}
						/>
					))}
				</div>
			</section>
		)
	}
</SiteLayout>

<style>
	.hero {
		min-height: calc(100svh - 2.85rem);
		display: grid;
		align-content: center;
		gap: var(--space-5);
		padding: var(--space-8) 0 var(--space-7);
	}

	.hero-brand {
		display: grid;
		justify-items: start;
	}

	.lede {
		max-width: 28rem;
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.5;
		color: var(--ink-muted);
		font-family: var(--font-ui);
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-1);
	}

	.latest {
		padding-bottom: var(--space-8);
		border-top: 1px solid var(--border);
		padding-top: var(--space-7);
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
		margin-bottom: var(--space-5);
	}

	.section-head h2 {
		margin: 0;
		font-size: 1.25rem;
	}

	.section-head a {
		font-family: var(--font-ui);
		font-size: 0.875rem;
		text-decoration: none;
		color: var(--ink-muted);
	}

	.section-head a:hover {
		color: var(--ink);
		background: var(--bg-hover);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: var(--space-4);
	}
</style>
