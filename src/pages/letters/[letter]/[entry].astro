---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import EntryNav from '../../../components/EntryNav.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const entries = await getCollection('entries');
	const letters = await getCollection('letters');
	const letterMap = new Map(letters.map((letter) => [letter.id, letter]));

	return entries
		.filter((entry) => letterMap.get(entry.data.letter)?.data.status === 'published')
		.map((entry) => ({
			params: { letter: entry.data.letter, entry: entry.id },
			props: { entry },
		}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const siblings = (await getCollection('entries'))
	.filter((item) => item.data.letter === entry.data.letter)
	.sort((a, b) => a.data.order - b.data.order);

const index = siblings.findIndex((item) => item.id === entry.id);
const prev = index > 0 ? siblings[index - 1] : null;
const next = index < siblings.length - 1 ? siblings[index + 1] : null;
const homeHref = `/letters/${entry.data.letter}/`;
---

<SiteLayout
	title={entry.data.title}
	description={`${entry.data.title} — stop ${index + 1} of ${siblings.length}`}
	image={entry.data.cover || undefined}
>
	<EntryNav
		homeHref={homeHref}
		index={index + 1}
		total={siblings.length}
		prev={
			prev
				? { href: `/letters/${entry.data.letter}/${prev.id}/`, title: prev.data.title }
				: null
		}
		next={
			next
				? { href: `/letters/${entry.data.letter}/${next.id}/`, title: next.data.title }
				: null
		}
	/>

	<article>
		{
			entry.data.cover && (
				<div class="cover">
					<img src={entry.data.cover} alt="" />
				</div>
			)
		}

		<header class="shell header motion-rise">
			<p class="eyebrow">
				<a href={homeHref}>Letter</a>
				<span aria-hidden="true">/</span>
				Stop {index + 1}
			</p>
			<p class="icon" aria-hidden="true">{entry.data.icon}</p>
			<h1>{entry.data.title}</h1>
			{
				entry.data.publishedAt && (
					<time datetime={entry.data.publishedAt.toISOString()}>
						{entry.data.publishedAt.toLocaleDateString('en-GB', {
							day: 'numeric',
							month: 'long',
							year: 'numeric',
						})}
					</time>
				)
			}
		</header>

		<div class="prose motion-fade">
			<Content />
		</div>
	</article>
</SiteLayout>

<style>
	.cover {
		width: 100%;
		max-height: 38vh;
		overflow: hidden;
		border-bottom: 1px solid var(--border);
	}

	.cover img {
		width: 100%;
		height: 38vh;
		object-fit: cover;
	}

	.header {
		padding-top: var(--space-6);
		padding-bottom: var(--space-5);
		max-width: var(--measure);
		margin-inline: auto;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-family: var(--font-ui);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.eyebrow a {
		color: var(--accent-strong);
		text-decoration: none;
	}

	.icon {
		margin: var(--space-3) 0 0;
		font-size: 2.2rem;
	}

	time {
		display: block;
		margin-top: calc(-1 * var(--space-2));
		font-family: var(--font-ui);
		font-size: 0.9rem;
		color: var(--ink-faint);
	}
</style>
